# Server Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# MongoDB Atlas Database URL
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spendmate

# JWT Secrets
JWT_SECRET=spendmate_super_secure_jwt_secret_change_in_production_key_32bytes
JWT_REFRESH_SECRET=spendmate_refresh_token_secret_change_in_production_key_32bytes
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Cloudinary (Optional for receipts & avatar storage)
CLOUDINARY_CLOUD_NAME=spendmate
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK (Optional: For real production push & token verification)
FIREBASE_PROJECT_ID=spendmate-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@spendmate.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
